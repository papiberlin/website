---
locale: multi
permalink: /:locale/atom.xml
---
<?xml version="1.0" encoding="utf-8"?>
<?xml-stylesheet href="/assets/feed.xsl" type="text/xsl"?>
{%- assign posts = collections.posts.resources | in_locale | sort: "date" | reverse -%}
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ site.metadata.title | xml_escape }}</title>
  <link href="{{ "/" | in_locale | absolute_url }}" rel="alternate"/>
  <link href="{{ "/atom.xml" | in_locale | absolute_url }}" rel="self"/>
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <id>{{ "/" | in_locale | absolute_url }}</id>
  <author>
    <name>{{ site.metadata.name | xml_escape }}</name>
    <email>{{ site.metadata.email | xml_escape }}</email>
  </author>

  {% for post in posts limit: 20 %}
  <entry>
    <title type="html">{{ post.data.title | xml_escape }}</title>
    <link href="{{ post.absolute_url }}"/>
    <updated>{{ post.date | date_to_xmlschema }}</updated>
    <id>{{ post.absolute_url }}</id>
    <content type="html">{{ post.content | xml_escape }}</content>
  </entry>
  {% endfor %}
</feed>
