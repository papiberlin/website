<!-- Home Jumbotron
================================================== -->
<section class="intro full-width">
    <div class="wrapintro">
        <h1>Papi Berlin</h1>
        <p class="lead">{{ "home.lead" | t }}</p>
        <a href="{{ "/about/" | in_locale | relative_url }}" class="btn">{{ "home.more" | t }}</a>
    </div>
</section>

<!-- Featured
================================================== -->
<section class="featured-posts">

    <div class="row listfeaturedtag">

        {% for post in featured_posts %}

        {% render "featuredbox", post: post %}

        {% endfor %}

    </div>

</section>

<!-- Posts Index
================================================== -->
{% if paginator.previous_page %}
<div id="jumptopageof"></div>
{% endif %}

<section class="recent-posts row flex-row-reverse">

    <div class="col-sm-12">

        <div class="section-title">
            <h2><span>{{ "posts.all" | t }}</span></h2>
        </div>

        <div class="masonrygrid row listrecent">

            {% for post in paginator.resources %}

            {% unless post.featured == true %}

            {% render "postbox", post: post, site: site %}

            {% endunless %}

            {% endfor %}

        </div>

        <!-- Pagination -->
        <div class="bottompagination">

            <span class="navigation" role="navigation">

                {% render "pagination", paginator: paginator %}

            </span>

        </div>

    </div>
</section>
